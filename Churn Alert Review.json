    {
      "id": "db88ba48-cc95-43e5-b2e8-e3dfc58da2a6",
      "name": "Build review page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const alerts = $('Get pending alerts').all().map((item) => item.json).filter((row) => row.id);\nconst names = new Map($input.all().map((item) => [item.json.account_id, item.json.account_name]));\n\nif (!alerts.length) return [{ json: { has_pending: false, pending_count: 0 } }];\n\n// Text from the table or the AI is shown as plain text, never as HTML.\nconst escapeHtml = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\"/g, '&quot;')\n  .replace(/\\n/g, '<br>');\n\nconst formFields = alerts.flatMap((alert) => {\n  const name = names.get(alert.account_id) || alert.account_id;\n  const card = [\n    '<hr>',\n    '<h3>' + escapeHtml(name) + ' (' + escapeHtml(alert.account_id) + ') - score ' + escapeHtml(alert.score) + '</h3>',\n    '<p><b>Alert date:</b> ' + escapeHtml(alert.alert_date) + '</p>',\n    '<p><b>Why:</b> ' + escapeHtml(alert.reasons) + '</p>',\n    '<p><b>Internal note:</b> ' + escapeHtml(alert.internal_note) + '</p>',\n    '<p><b>Subject:</b> ' + escapeHtml(alert.draft_subject) + '</p>',\n    '<p><b>Draft email:</b><br>' + escapeHtml(alert.draft_body) + '</p>',\n  ].join('');\n\n  return [\n    { fieldType: 'html', elementName: 'card_' + alert.id, html: card },\n    {\n      fieldLabel: 'Decision for alert ' + alert.id,\n      fieldName: 'decision_' + alert.id,\n      fieldType: 'dropdown',\n      fieldOptions: { values: [{ option: 'keep pending' }, { option: 'approved' }, { option: 'rejected' }, { option: 'edit' }] },\n      defaultValue: 'keep pending',\n      requiredField: true,\n    },\n    {\n      fieldLabel: 'Note for alert ' + alert.id,\n      fieldName: 'note_' + alert.id,\n      fieldType: 'textarea',\n      placeholder: 'What should change, or why you rejected it',\n      requiredField: false,\n    },\n  ];\n});\n\nreturn [{\n  json: {\n    has_pending: true,\n    pending_count: alerts.length,\n    alert_ids: alerts.map((alert) => alert.id),\n    form_fields: formFields,\n  },\n}];"
      }
    },
