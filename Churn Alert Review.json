    {
      "id": "996b346b-5f2f-47e1-b080-e4a462be43bb",
      "name": "Summarize decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -96
      ],
      "parameters": {
        "jsCode": "const decisions = $('Prepare decisions').all().map((item) => item.json);\nconst count = (status) => decisions.filter((row) => row.review_status === status).length;\n\nreturn [{\n  json: {\n    summary: 'Approved: ' + count('approved') +\n      ', rejected: ' + count('rejected') +\n      ', edit: ' + count('edit') +\n      ', still pending: ' + count('pending review') +\n      '. Nothing was sent. Approved means ready to copy.',\n  },\n}];"
      },
      "executeOnce": true
    },
