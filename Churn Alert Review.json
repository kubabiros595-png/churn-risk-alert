    {
      "id": "13b4010c-32b1-404f-bf5e-03cdfb15b161",
      "name": "Prepare decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -96
      ],
      "parameters": {
        "jsCode": "const answers = $input.first().json;\nconst alertIds = $('Build review page').first().json.alert_ids;\n\nreturn alertIds.map((id) => {\n  const choice = answers['decision_' + id] ?? answers['Decision for alert ' + id] ?? 'keep pending';\n  const note = answers['note_' + id] ?? answers['Note for alert ' + id] ?? '';\n\n  return {\n    json: {\n      row_id: id,\n      review_status: choice === 'keep pending' ? 'pending review' : choice,\n      reviewer_note: String(note).trim(),\n    },\n  };\n});"
      }
    },
    {
      "id": "a5ea839a-f5a3-4200-b96d-4df1fcdfe8b4",
      "name": "Save decision",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
